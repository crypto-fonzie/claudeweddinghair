{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/content/**",
              "components/core/**",
              "components/forms/**",
              "components/navigation/**",
              "ui_kits/partner-deck/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Instrument Serif|Karla))/i]",
        "message": "Font not provided by the design system. Available: Instrument Serif, Karla."
      },
      {
        "selector": "JSXOpeningElement[name.name='Block'] > JSXAttribute > JSXIdentifier[name!=/^(?:surface|padding|as|children|style|key|ref|className|style|children)$/]",
        "message": "<Block> doesn't accept that prop. Declared props: surface, padding, as, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Block'] > JSXAttribute[name.name='surface'] > Literal[value!=/^(?:tulle|morning|ink|raised|outline)$/]",
        "message": "<Block> surface must be one of 'tulle' | 'morning' | 'ink' | 'raised' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|href|disabled|type|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, href, disabled, type, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|inverse|quiet)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'inverse' | 'quiet'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<Button> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChoiceOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|note|key|ref|className|style|children)$/]",
        "message": "<ChoiceOption> doesn't accept that prop. Declared props: value, label, note."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|as|children|style|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: tone, as, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|htmlFor|required|children|style|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: label, hint, htmlFor, required, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:multiline|rows|invalid|style|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: multiline, rows, invalid, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Lockup'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|tone|size|descriptor|style|key|ref|className|style|children)$/]",
        "message": "<Lockup> doesn't accept that prop. Declared props: variant, tone, size, descriptor, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Lockup'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:stacked|horizontal|name)$/]",
        "message": "<Lockup> variant must be one of 'stacked' | 'horizontal' | 'name'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Lockup'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|inverse|photo)$/]",
        "message": "<Lockup> tone must be one of 'light' | 'inverse' | 'photo'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhotoFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|shot|note|ratio|caption|style|key|ref|className|style|children)$/]",
        "message": "<PhotoFrame> doesn't accept that prop. Declared props: src, alt, shot, note, ratio, caption, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhotoFrame'] > JSXAttribute[name.name='shot'] > Literal[value!=/^(?:back-of-head|hands|room|party)$/]",
        "message": "<PhotoFrame> shot must be one of 'back-of-head' | 'hands' | 'room' | 'party'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pillar'] > JSXAttribute > JSXIdentifier[name!=/^(?:word|fear|children|tone|style|key|ref|className|style|children)$/]",
        "message": "<Pillar> doesn't accept that prop. Declared props: word, fear, children, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pillar'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|inverse)$/]",
        "message": "<Pillar> tone must be one of 'light' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PinMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:height|tone|weight|title|style|key|ref|className|style|children)$/]",
        "message": "<PinMark> doesn't accept that prop. Declared props: height, tone, weight, title, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PullQuote'] > JSXAttribute > JSXIdentifier[name!=/^(?:attribution|tone|size|children|style|key|ref|className|style|children)$/]",
        "message": "<PullQuote> doesn't accept that prop. Declared props: attribution, tone, size, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PullQuote'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:block|plain|inverse)$/]",
        "message": "<PullQuote> tone must be one of 'block' | 'plain' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Rule'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|inset|style|key|ref|className|style|children)$/]",
        "message": "<Rule> doesn't accept that prop. Declared props: tone, inset, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHead'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|headline|lede|tone|align|size|style|key|ref|className|style|children)$/]",
        "message": "<SectionHead> doesn't accept that prop. Declared props: eyebrow, headline, lede, tone, align, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHead'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|inverse)$/]",
        "message": "<SectionHead> tone must be one of 'light' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHead'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<SectionHead> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<SelectOption> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='FooterColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|items|key|ref|className|style|children)$/]",
        "message": "<FooterColumn> doesn't accept that prop. Declared props: title, items."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|href|key|ref|className|style|children)$/]",
        "message": "<NavLink> doesn't accept that prop. Declared props: id, label, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='StepRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:when|title|children|tone|divider|style|key|ref|className|style|children)$/]",
        "message": "<StepRow> doesn't accept that prop. Declared props: when, title, children, tone, divider, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StepRow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|inverse)$/]",
        "message": "<StepRow> tone must be one of 'light' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Testimonial'] > JSXAttribute > JSXIdentifier[name!=/^(?:credit|tone|size|children|style|key|ref|className|style|children)$/]",
        "message": "<Testimonial> doesn't accept that prop. Declared props: credit, tone, size, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Testimonial'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|inverse)$/]",
        "message": "<Testimonial> tone must be one of 'light' | 'inverse'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
